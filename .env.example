# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# Database Connection (MySQL)
DATABASE_URL="mysql://username:password@localhost:3306/serviqa_db"

# JWT Authentication
JWT_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# Storage
UPLOAD_DIR="./uploads"

# Payment Sandbox Mode
PAYMENT_MODE="MANUAL_SANDBOX"
